name = "zoochess"
main = "worker.js"
compatibility_date = "2025-04-01"

[[durable_objects.bindings]]
name = "ROOM"
class_name = "Room"
[[durable_objects.bindings]]
name = "LOBBY"
class_name = "Lobby"
[[durable_objects.bindings]]
name = "ACC"
class_name = "Accounts"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Room", "Lobby", "Accounts"]
